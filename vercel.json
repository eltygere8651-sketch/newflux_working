{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/youtube/playlist-info",
      "destination": "/api/youtube/playlist?action=info"
    },
    {
      "source": "/api/youtube/sync-explore-playlists",
      "destination": "/api/youtube/playlist?action=sync"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
